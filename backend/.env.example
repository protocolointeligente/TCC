# ── Banco de dados ──────────────────────────────────────────────────────────
# PostgreSQL — substitua com sua URL de produção (Railway, Render, Supabase, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academia_ia

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs dos produtos criados no Stripe Dashboard → Products
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL do frontend em produção (sem barra final)
FRONTEND_URL=https://seu-projeto.vercel.app

# CORS: lista de origens separadas por vírgula, ou * para liberar tudo (dev)
# Em produção, coloque apenas o domínio do frontend
ALLOWED_ORIGINS=https://seu-projeto.vercel.app
